# Camty C2 服务器环境（/etc/camty/c2.env，权限 0600）
# token/psk 由部署方生成：python3 -c "import secrets; print(secrets.token_hex(16))"
CAMTY_TOKEN=替换为48位hex
CAMTY_PSK=替换为64位hex
CAMTY_BEACON_PORT=8443
CAMTY_API_PORT=8801
# 伪装 profile（与植入体 build_beacon.py --path-beacon/--path-result 一致）
CAMTY_BEACON_PATH=/api/v1/heartbeat
CAMTY_RESULT_PATH=/api/v1/report
CAMTY_BEACON_CTYPE=application/json
