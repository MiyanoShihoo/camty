/* smoke_bsh.bsh - environment smoke test: bsh.args passing, AbstractTranslet abstract
 * method discovery, javassist class build with empty-abstract-method impls.
 * Usage: java -cp "<utils-bundle.jar>" bsh.Interpreter smoke_bsh.bsh <arg1> <arg2>
 */

java.lang.System.err.println("[*] java=" + java.lang.System.getProperty("java.version"));
try {
    String[] a = bsh.args;
    java.lang.System.err.println("[*] bsh.args=" + java.util.Arrays.toString(a));
} catch (Throwable t) {
    java.lang.System.err.println("[!] bsh.args UNAVAILABLE: " + t);
}

String toSrcType(Class c) {
    if (!c.isArray()) return c.getName();
    String n = c.getName();
    int depth = 0;
    while (n.charAt(depth) == '[') depth++;
    String base = n.substring(depth);
    String src;
    if (base.startsWith("L") && base.endsWith(";")) src = base.substring(1, base.length() - 1);
    else if (base.equals("I")) src = "int";
    else if (base.equals("J")) src = "long";
    else if (base.equals("Z")) src = "boolean";
    else if (base.equals("B")) src = "byte";
    else if (base.equals("S")) src = "short";
    else if (base.equals("C")) src = "char";
    else if (base.equals("F")) src = "float";
    else if (base.equals("D")) src = "double";
    else src = base;
    for (int k = 0; k < depth; k++) src = src + "[]";
    return src;
}

Class c = Class.forName("com.sun.org.apache.xalan.internal.xsltc.runtime.AbstractTranslet");
java.lang.reflect.Method[] ms = c.getMethods();
java.lang.System.err.println("[*] AbstractTranslet abstract methods:");
for (int i = 0; i < ms.length; i++) {
    java.lang.reflect.Method m = ms[i];
    if (java.lang.reflect.Modifier.isAbstract(m.getModifiers())) {
        java.lang.System.err.println("    " + m.toGenericString());
    }
}
java.lang.System.err.println("[*] classes: "
    + Class.forName("org.apache.commons.collections.map.LazyMap") + " "
    + Class.forName("org.apache.commons.collections.keyvalue.TiedMapEntry") + " "
    + Class.forName("javassist.ClassPool") + " "
    + Class.forName("com.sun.org.apache.xalan.internal.xsltc.trax.TemplatesImpl"));

// javassist build smoke: subclass AbstractTranslet, <clinit>, ctor, empty abstract impls
javassist.ClassPool p = javassist.ClassPool.getDefault();
javassist.CtClass tc = p.makeClass("SmokeX");
tc.setSuperclass(p.get("com.sun.org.apache.xalan.internal.xsltc.runtime.AbstractTranslet"));
tc.makeClassInitializer().insertBefore("java.lang.System.err.println(\"[smoke] <clinit> compiled by javassist\");");
Object emptyCt = java.lang.reflect.Array.newInstance(Class.forName("javassist.CtClass"), 0);
javassist.CtConstructor c0 = new javassist.CtConstructor(emptyCt, tc);
c0.setBody("{}");
tc.addConstructor(c0);

java.lang.reflect.Method[] am = c.getMethods();
java.util.Set seen = new java.util.HashSet();
for (int i = 0; i < am.length; i++) {
    java.lang.reflect.Method m = am[i];
    if (!java.lang.reflect.Modifier.isAbstract(m.getModifiers())) continue;
    Class[] pt = m.getParameterTypes();
    String sig = m.getName() + "(";
    for (int j = 0; j < pt.length; j++) {
        if (j > 0) sig = sig + ", ";
        sig = sig + toSrcType(pt[j]) + " p" + j;
    }
    sig = sig + ")";
    if (seen.contains(sig)) continue;
    seen.add(sig);
    try {
        String msrc = "public " + toSrcType(m.getReturnType()) + " " + sig + " {}";
        tc.addMethod(javassist.CtNewMethod.make(msrc, tc));
        java.lang.System.err.println("[+] smoke impl: " + msrc);
    } catch (Throwable t) {
        java.lang.System.err.println("[!] smoke impl FAILED: " + sig + " :: " + t);
    }
}
byte[] bb = tc.toBytecode();
java.lang.System.err.println("[+] smoke bytecode=" + bb.length + " bytes");
return;
